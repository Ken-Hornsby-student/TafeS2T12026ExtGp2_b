<Page
    x:Class="Calculator.Currency"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">


	<Page.Resources>

		<!-- Text Block Title -->
		<Style x:Key="subTitles" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Arial"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="GreenYellow"/>
			<!--<Setter Property="FontStyle" Value="Bold"/>-->
			<Setter Property="Height" Value="35"/>
			<Setter Property="Width" Value="230"/>
			<Setter Property="Padding" Value="5,5,5,5"/>
		</Style>

		<!-- Text Combo Box -->
		<Style x:Key="comboBox" TargetType="ComboBox">
			<Setter Property="FontFamily" Value="Arial"/>
			<Setter Property="FontSize" Value="14"/>
			<!--<Setter Property="Foreground" Value="GreenYellow"/>-->
			<!--<Setter Property="FontStyle" Value="Bold"/>-->
			<Setter Property="Height" Value="40"/>
			<Setter Property="Width" Value="225"/>
			<Setter Property="Padding" Value="5,5,5,5"/>
			<Setter Property="BorderBrush" Value="DarkGoldenrod"/>
		</Style>

		<!-- Left Side Text Block -->
		<Style x:Key="leftSideWritting" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Arial"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="White"/>
			<!--<Setter Property="FontStyle" Value="Bold"/>-->
			<Setter Property="Height" Value="35"/>
			<Setter Property="Width" Value="230"/>
			<Setter Property="Padding" Value="5,5,5,5"/>
		</Style>

		<!--Button Composure-->
		<Style TargetType="Button">
			<Setter Property="Background" Value="DarkCyan" />
			<Setter Property="FontStyle" Value="Italic"  />
			<Setter Property="FontFamily" Value="Arial" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="5" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="MinWidth" Value="80" />
			<Setter Property="BorderBrush" Value="DarkGoldenrod"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>

	</Page.Resources>


	<Grid>

		<!--

		Student:	Ken Hornsby and Others
		Collage:	TAFE SA
		Year:		2026

		-->
		

		<!-- Outer Bourder Margin Stack Panel -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="Brown" BorderThickness="1" CornerRadius="5" BorderBrush="White" Height="450" Width="720" Padding="10"  >

			<!-- Container Stack Panel -->
			<StackPanel Orientation="Vertical" VerticalAlignment="Center" Background="Gray" BorderThickness="5" CornerRadius="5" BorderBrush="Cyan" Height="430" Width="670" Padding="10" >

				<!-- Top Horizontal Stack Panel with Text Block title -->
				<StackPanel Orientation="Vertical" VerticalAlignment="Center" Height="50" Width="570"  Padding="5" >
					<TextBlock Text="Currency Converter Calculator" HorizontalAlignment="Center" FontSize="25" Foreground="GreenYellow" />
				</StackPanel>


				<!-- First Inner Body Stack Panel -->
				<StackPanel Orientation="Vertical">

					<!-- Second Line Items -->
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="Amount $" Style="{StaticResource subTitles}" Width="170" />
						<TextBlock Text="From" Style="{StaticResource subTitles}" />
						<TextBlock Text="To" Style="{StaticResource subTitles}" />
					</StackPanel>

					<!-- Outer Currency choise Stack Panel -->
					<StackPanel Orientation="Horizontal">

						<!-- Currency choices -->
						<StackPanel Orientation="Horizontal" Height="40">
							<!--<TextBlock Text="Cusne"/>-->
							<!--<TextBlock />-->
							<TextBox x:Name="exchangeAmountTextBox" PlaceholderText="Enter amount to exchange." Width="190" BorderThickness="3"
					BorderBrush="DarkGoldenrod" />
						</StackPanel>

						<!-- Initual currency -->
						<ComboBox x:Name="currencyFromComboBox" Style="{StaticResource comboBox}"
					PlaceholderText="Choose an initial currency." Padding="10" >
							<x:String>US Dollar</x:String>
							<x:String>European Euro</x:String>
							<x:String>British Pound</x:String>
							<x:String>Idian Rupee</x:String>
						</ComboBox>

						<!-- Currency converted to -->
						<ComboBox x:Name="currencyToComboBox" Style="{StaticResource comboBox}"
					PlaceholderText="Choose which to convert to." Padding="10" >
							<x:String>to US Dollar</x:String>
							<x:String>to European Euro</x:String>
							<x:String>to British Pound</x:String>
							<x:String>to Idian Rupee</x:String>
						</ComboBox>

					</StackPanel>

				</StackPanel>


				<!-- Center Horizontal Stack Panel with Text Boxes and information -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="180" Width="620" Padding="5" >

					<StackPanel Orientation="Vertical" >
						<TextBlock x:Name="fromAmountAndCurrencyTextBlock" Style="{StaticResource leftSideWritting}" Text="Amount and Currency" Width="500" />
						<TextBlock x:Name="toAmountAndCurrencyTextBlock" Style="{StaticResource leftSideWritting}" Text="to amount and currency." Width="500" />
						<TextBlock x:Name="exchangeRateTextBlock" Style="{StaticResource leftSideWritting}" Text="Enquired exchange rate." Width="500" />
						<TextBlock x:Name="flipExchangeRateTextBlock" Style="{StaticResource leftSideWritting}" Foreground="White" Text="Fliped exchange rate." Width="500" />
					</StackPanel>

				</StackPanel>

				<!-- Bottom Horizontal Stack Panel with Calculate Currency and Exit Buttons -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

					<StackPanel Orientation="Vertical" VerticalAlignment="Center" Height="90" Width="300" Padding="5" >
						<Button x:Name="currencyCalcButton" Content="Calculate Currency" HorizontalAlignment="Center" Click="currencyCalcButtonClick" />
						<Button x:Name="exitButton" Content="Exit" HorizontalAlignment="Center" Click="exitButtonClick" />
					</StackPanel>

				</StackPanel>

			</StackPanel>

		</StackPanel>


	</Grid>
</Page>
